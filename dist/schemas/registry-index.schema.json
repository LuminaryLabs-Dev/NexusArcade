{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminarylabs.dev/schemas/nexus-arcade/registry-index.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "registryVersion", "games"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "registryVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "games": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "slug", "title", "version", "status", "manifestPath"],
        "properties": {
          "id": { "type": "string", "pattern": "^NXA-[0-9]{6}$" },
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "genre": { "type": "string" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "status": { "enum": ["prototype", "promoted", "archived"] },
          "featured": { "type": "boolean" },
          "sortOrder": { "type": "number" },
          "thumbnail": { "type": "string" },
          "controls": { "type": "array", "items": { "type": "string" } },
          "manifestPath": { "type": "string", "pattern": "^registry/games/NXA-[0-9]{6}\\.json$" }
        }
      }
    }
  }
}
