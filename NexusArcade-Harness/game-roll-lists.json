{
  "version": 1,
  "description": "Independent game-scaffold rolls. These abstract selections are retained even when the current runtime needs new capabilities.",
  "lists": {
    "genre": [
      {"id":"genre-system-puzzle","text":"The player reads and changes a connected system to reach a stable outcome.","supportedFamilies":["conduit"],"provides":["genre:system-puzzle"],"requires":["concept_integration"]},
      {"id":"genre-route-racing","text":"The player learns a spatial route and improves a timed run.","supportedFamilies":["rally"],"provides":["genre:route-racing"],"requires":["concept_integration"]},
      {"id":"genre-spatial-exploration","text":"The player discovers how separated spaces connect and change.","supportedFamilies":["conduit","rally"],"provides":["genre:exploration"],"requires":["concept_integration"]},
      {"id":"genre-physics-playground","text":"The player changes forces and uses their effects to alter a route or object.","supportedFamilies":["rally"],"provides":["genre:physics"],"requires":["concept_integration"]},
      {"id":"genre-reactive-world","text":"A changing world process responds to player actions and alters available choices.","supportedFamilies":["conduit","rally"],"provides":["genre:reactive-world"],"requires":["concept_integration"]},
      {"id":"genre-layered-traversal","text":"The player moves between height levels as part of the central challenge.","supportedFamilies":[],"requiredCapability":"vertical-locomotion","provides":["genre:layered-traversal"],"requires":["concept_integration"]},
      {"id":"genre-environmental-strategy","text":"The player changes active connections in the environment to alter the best route.","supportedFamilies":["conduit","rally"],"provides":["genre:environmental-strategy"],"requires":["concept_integration"]},
      {"id":"genre-temporal-arcade","text":"The player acts within a changing sequence where timing alters later options.","supportedFamilies":["conduit","rally"],"provides":["genre:temporal-arcade"],"requires":["concept_integration"]}
    ],
    "gameForm": [
      {"id":"form-flow-control","text":"A changing system must be routed through a space before its resource limit is reached.","runtimeFamily":"conduit","provides":["goal:system-state"],"requires":["action_consequence","pressure_tradeoff"]},
      {"id":"form-route-mastery","text":"Movement through a shaped space rewards learning its route and choosing lines under pressure.","runtimeFamily":"rally","provides":["goal:route"],"requires":["space_action","replay_choice"]},
      {"id":"form-spatial-transformation","text":"Player actions change active routes and alter how the player moves through the system.","runtimeFamily":"conduit","provides":["world:transformation"],"requires":["action_consequence","progression_escalation"]},
      {"id":"form-force-navigation","text":"Steering and braking redirect player momentum through a shaped route.","runtimeFamily":"rally","provides":["world:force"],"requires":["action_consequence","space_action"]},
      {"id":"form-reactive-ecosystem","text":"A changing world process responds to player actions and alters routes or objectives.","runtimeFamily":"conduit","provides":["world:reactivity"],"requires":["action_consequence","progression_escalation"]},
      {"id":"form-layered-traversal","text":"Movement between height levels creates the route and the central player decision.","runtimeFamily":null,"requiredCapability":"vertical-locomotion","provides":["movement:vertical"],"requires":["space_action","progression_escalation","engine_capability"]},
      {"id":"form-temporal-synchrony","text":"Player timing changes how a connected system progresses through its resource states.","runtimeFamily":"conduit","provides":["system:synchrony"],"requires":["action_consequence","pressure_tradeoff"]},
      {"id":"form-spatial-network","text":"Player actions change active connections and create a usable path through a system.","runtimeFamily":"conduit","provides":["space:topology"],"requires":["space_action","progression_escalation"]}
    ],
    "concepts": [
      {"id":"concept-growth","text":"Growth increases reach while creating new demands.","provides":["concept:expansion"],"requires":["concept_integration"]},
      {"id":"concept-exchange","text":"An exchange changes what each side can do next.","provides":["concept:reciprocity"],"requires":["concept_integration"]},
      {"id":"concept-dependency","text":"One part becomes available only when another part changes.","provides":["concept:dependency"],"requires":["concept_integration"]},
      {"id":"concept-migration","text":"Movement between places changes what can be reached or retained.","provides":["concept:relocation"],"requires":["concept_integration"]},
      {"id":"concept-debt","text":"A gain now creates a cost that must be paid later.","provides":["concept:deferred-cost"],"requires":["concept_integration","pressure_tradeoff"]},
      {"id":"concept-echo","text":"An earlier action returns later in a changed form.","provides":["concept:recurrence"],"requires":["concept_integration","feedback_state"]},
      {"id":"concept-decay","text":"A useful state weakens unless the player maintains it.","provides":["concept:decay"],"requires":["concept_integration","pressure_tradeoff"]},
      {"id":"concept-inversion","text":"A familiar relationship reverses and changes the best choice.","provides":["concept:reversal"],"requires":["concept_integration"]},
      {"id":"concept-scarcity","text":"Limited capacity makes every allocation consequential.","provides":["concept:allocation"],"requires":["concept_integration","pressure_tradeoff"]},
      {"id":"concept-inheritance","text":"A change in one place affects a later place or state.","provides":["concept:inheritance"],"requires":["concept_integration","progression_escalation"]},
      {"id":"concept-translation","text":"A state or object changes meaning as it crosses a boundary.","provides":["concept:transformation"],"requires":["concept_integration","feedback_state"]},
      {"id":"concept-synchrony","text":"Separate parts must be brought into a useful shared state.","provides":["concept:coordination"],"requires":["concept_integration"]},
      {"id":"concept-friction","text":"Progress is possible, but each transition has a cost.","provides":["concept:friction"],"requires":["concept_integration","pressure_tradeoff"]},
      {"id":"concept-memory","text":"The space retains evidence of earlier actions.","provides":["concept:history"],"requires":["concept_integration","feedback_state"]},
      {"id":"concept-convergence","text":"Separate routes or forces meet at one consequential point.","provides":["concept:convergence"],"requires":["concept_integration","space_action"]},
      {"id":"concept-drift","text":"A system gradually moves away from its intended state.","provides":["concept:drift"],"requires":["concept_integration","pressure_tradeoff"]}
    ],
    "goal": [
      {"id":"goal-stabilize","text":"Bring a changing system into a safe target state.","provides":["goal:stability"],"requires":["action_consequence"]},
      {"id":"goal-connect","text":"Create a working connection between separated places.","provides":["goal:connection"],"requires":["space_action"]},
      {"id":"goal-escape","text":"Reach the marked exit before time runs out.","provides":["goal:escape"],"requires":["pressure_tradeoff"]},
      {"id":"goal-complete-sequence","text":"Reach each spatial marker in order while time and route choices constrain the run.","provides":["goal:sequence"],"requires":["progression_escalation"]},
      {"id":"goal-balance","text":"Keep competing systems within safe limits while making progress.","provides":["goal:balance"],"requires":["pressure_tradeoff"]},
      {"id":"goal-redirect","text":"Redirect a process so it reaches the intended destination.","provides":["goal:redirection"],"requires":["action_consequence"]},
      {"id":"goal-deliver","text":"Move required objects through a changing network of destinations.","provides":["goal:delivery"],"requires":["space_action","progression_escalation"]},
      {"id":"goal-master-route","text":"Complete a route cleanly, then improve the result through practice.","provides":["goal:mastery"],"requires":["replay_choice"]}
    ],
    "space": [
      {"id":"space-loop","text":"A loop brings the player back near earlier choices by a different route.","provides":["space:loop"],"requires":["space_action"]},
      {"id":"space-radial","text":"A hub connects several arms with different risks or costs.","provides":["space:hub"],"requires":["space_action"]},
      {"id":"space-branch","text":"Branching routes split and later reconnect.","provides":["space:branch"],"requires":["space_action","replay_choice"]},
      {"id":"space-crossing","text":"Crossing paths create timing and route-order decisions.","provides":["space:crossing"],"requires":["space_action","pressure_tradeoff"]},
      {"id":"space-ring","text":"A ring-shaped space makes the long and short paths visibly different.","provides":["space:ring"],"requires":["space_action"]},
      {"id":"space-islands","text":"Separated platforms or rooms require deliberate transitions.","provides":["space:separation"],"requires":["space_action","progression_escalation"]},
      {"id":"space-corridors","text":"Narrow and wide passages trade precision for safety.","provides":["space:constraint"],"requires":["space_action","pressure_tradeoff"]},
      {"id":"space-open-field","text":"An open area lets the player choose approach and order.","provides":["space:choice"],"requires":["space_action","replay_choice"]},
      {"id":"space-spiral","text":"A rising or descending spiral revisits space at a new stage.","provides":["space:layering"],"requires":["space_action","progression_escalation"]},
      {"id":"space-switchback","text":"Switchbacks make direction changes and sightlines part of navigation.","provides":["space:turns"],"requires":["space_action","feedback_state"]}
    ],
    "action": [
      {"id":"action-redirect","text":"Redirect a moving or flowing process at a reachable control.","provides":["action:redirect"],"requires":["action_consequence","feedback_state"]},
      {"id":"action-carry","text":"Carry an object between places and choose where it goes next.","provides":["action:carry"],"requires":["action_consequence","space_action"]},
      {"id":"action-activate","text":"Activate a spatial element to change access or state.","provides":["action:activate"],"requires":["action_consequence","feedback_state"]},
      {"id":"action-steer","text":"Steer through a route and adjust speed before difficult turns.","provides":["action:steer"],"requires":["action_consequence","space_action"]},
      {"id":"action-sequence","text":"Activate elements in an order that changes later options.","provides":["action:sequence"],"requires":["action_consequence","progression_escalation"]},
      {"id":"action-balance","text":"Adjust a system while preserving a second competing condition.","provides":["action:balance"],"requires":["action_consequence","pressure_tradeoff"]},
      {"id":"action-position","text":"Occupy or leave a place to alter what the world permits.","provides":["action:position"],"requires":["action_consequence","space_action"]},
      {"id":"action-time","text":"Wait, move or act at a useful moment in a changing process.","provides":["action:timing"],"requires":["action_consequence","pressure_tradeoff"]}
    ],
    "pressure": [
      {"id":"pressure-countdown","text":"A visible timer makes route and action order matter.","provides":["pressure:time"],"requires":["pressure_tradeoff"]},
      {"id":"pressure-decay","text":"A useful state decays unless the player maintains it.","provides":["pressure:decay"],"requires":["pressure_tradeoff","feedback_state"]},
      {"id":"pressure-capacity","text":"A limited resource or space makes allocation consequential.","provides":["pressure:capacity"],"requires":["pressure_tradeoff"]},
      {"id":"pressure-spread","text":"A changing condition spreads across connected parts of the world.","provides":["pressure:spread"],"requires":["pressure_tradeoff","progression_escalation"]},
      {"id":"pressure-route","text":"A route becomes more costly or less available over time.","provides":["pressure:route"],"requires":["pressure_tradeoff","space_action"]},
      {"id":"pressure-precision","text":"Small movement errors increase cost but do not immediately end the run.","provides":["pressure:precision"],"requires":["pressure_tradeoff","feedback_state"]},
      {"id":"pressure-conflict","text":"Two useful outcomes compete for the same time or resource.","provides":["pressure:conflict"],"requires":["pressure_tradeoff"]},
      {"id":"pressure-uncertainty","text":"The player must act with partial information and can improve their read.","provides":["pressure:information"],"requires":["pressure_tradeoff","feedback_state"]}
    ],
    "progression": [
      {"id":"progression-unlock","text":"A completed action opens a new route or interaction.","provides":["progression:unlock"],"requires":["progression_escalation"]},
      {"id":"progression-escalate","text":"Later stages add pressure to an already understood rule.","provides":["progression:escalation"],"requires":["progression_escalation"]},
      {"id":"progression-transform","text":"Later actions change how an earlier part of the space behaves.","provides":["progression:transform"],"requires":["progression_escalation","feedback_state"]},
      {"id":"progression-sequence","text":"Each completed step changes the next available choice.","provides":["progression:sequence"],"requires":["progression_escalation"]},
      {"id":"progression-reveal","text":"Progress reveals a route or state that was previously hidden.","provides":["progression:reveal"],"requires":["progression_escalation","feedback_state"]},
      {"id":"progression-compress","text":"The space or available time tightens as the player advances.","provides":["progression:compression"],"requires":["progression_escalation","pressure_tradeoff"]},
      {"id":"progression-branch","text":"A milestone creates a lasting choice between different next paths.","provides":["progression:branch"],"requires":["progression_escalation","replay_choice"]},
      {"id":"progression-repair","text":"An early mistake remains recoverable through a later spatial choice.","provides":["progression:recovery"],"requires":["progression_escalation","replay_choice"]}
    ],
    "replay": [
      {"id":"replay-personal-best","text":"A saved personal best gives the player a measurable improvement target.","provides":["replay:mastery"],"requires":["replay_choice"]},
      {"id":"replay-alternate-route","text":"A different route trades time against safety or resource loss.","provides":["replay:route-choice"],"requires":["replay_choice","space_action"]},
      {"id":"replay-order","text":"Changing action order creates a meaningful second strategy.","provides":["replay:order"],"requires":["replay_choice","action_consequence"]},
      {"id":"replay-seed-layout","text":"A new layout changes the spatial problem while preserving learned rules.","provides":["replay:variation"],"requires":["replay_choice","space_action"]},
      {"id":"replay-risk","text":"A faster, riskier approach competes with a reliable approach.","provides":["replay:risk"],"requires":["replay_choice","pressure_tradeoff"]},
      {"id":"replay-efficiency","text":"The player returns to reduce wasted movement or resource use.","provides":["replay:efficiency"],"requires":["replay_choice","action_consequence"]},
      {"id":"replay-mastery","text":"Practice improves timing, route reading or control precision.","provides":["replay:skill"],"requires":["replay_choice","feedback_state"]},
      {"id":"replay-challenge","text":"A remixed challenge keeps the central interaction and changes its demands.","provides":["replay:challenge"],"requires":["replay_choice","progression_escalation"]}
    ],
    "presentation": [
      {"id":"presentation-luminous","text":"Bright state indicators make active routes and changed states legible.","provides":["presentation:state-readability"],"requires":["feedback_state"]},
      {"id":"presentation-layered-depth","text":"Foreground, middle distance and landmarks make navigation readable.","provides":["presentation:depth"],"requires":["space_action"]},
      {"id":"presentation-industrial","text":"Large structural forms make flow, access and pressure feel physical.","provides":["presentation:material-identity"],"requires":["feedback_state"]},
      {"id":"presentation-organic","text":"Soft branching forms make growth and change visible in the space.","provides":["presentation:shape-language"],"requires":["feedback_state"]},
      {"id":"presentation-minimal","text":"Clear silhouettes and restrained color keep choices readable.","provides":["presentation:clarity"],"requires":["feedback_state"]},
      {"id":"presentation-night","text":"Local light pools reveal important routes and state changes.","provides":["presentation:lighting"],"requires":["feedback_state","space_action"]},
      {"id":"presentation-scale","text":"Oversized landmarks communicate distance and route hierarchy.","provides":["presentation:scale"],"requires":["space_action"]},
      {"id":"presentation-motion","text":"Motion and small effects show where a process is active or blocked.","provides":["presentation:motion"],"requires":["feedback_state"]},
      {"id":"presentation-color","text":"Distinct color roles separate useful, risky and completed states.","provides":["presentation:color-code"],"requires":["feedback_state"]},
      {"id":"presentation-silhouette","text":"Distinct object shapes communicate function before labels are read.","provides":["presentation:silhouette"],"requires":["feedback_state"]}
    ],
    "links": [
      {"id":"link-action-changes-world","text":"A player action changes a named world state and produces a visible consequence.","fills":["action_consequence","feedback_state","concept_integration"],"opens":["feedback_state"]},
      {"id":"link-space-enables-action","text":"Distance, blockage or connection determines where an action can happen.","fills":["space_action","concept_integration"],"opens":[]},
      {"id":"link-pressure-changes-choice","text":"The pressure makes two actions or routes carry different costs.","fills":["pressure_tradeoff","concept_integration"],"opens":["action_consequence"]},
      {"id":"link-progress-unlocks","text":"A completed stage changes access or raises the next demand.","fills":["progression_escalation","concept_integration"],"opens":["feedback_state"]},
      {"id":"link-replay-tradeoff","text":"A second attempt can choose a different route or order and improve a measurable result.","fills":["replay_choice","concept_integration"],"opens":["pressure_tradeoff"]},
      {"id":"link-concept-behavior","text":"The concept changes an action, cost, route, state or objective during play.","fills":["concept_integration"],"opens":["action_consequence"]},
      {"id":"link-feedback-guides","text":"A visible state tells the player what changed and what choice is now available.","fills":["feedback_state"],"opens":[]},
      {"id":"link-risk-recovery","text":"A risky choice has a visible cost and a recoverable alternative.","fills":["pressure_tradeoff","replay_choice"],"opens":["progression_escalation"]}
    ],
    "capabilityPatterns": [
      {"id":"capability-spatial-force","text":"A spatial force changes player or object movement.","fills":["engine_capability"],"capabilityId":"spatial-force"},
      {"id":"capability-changing-geometry","text":"World geometry changes during play in response to a domain state.","fills":["engine_capability"],"capabilityId":"dynamic-geometry"},
      {"id":"capability-world-agent","text":"A world actor moves and reacts to the player's state or position.","fills":["engine_capability"],"capabilityId":"reactive-agent"},
      {"id":"capability-layered-movement","text":"Movement crosses height levels or uses a vertical traversal action.","fills":["engine_capability"],"capabilityId":"vertical-locomotion"},
      {"id":"capability-system-traversal","text":"The player discovers and moves through spaces whose connections are not fixed.","fills":["engine_capability"],"capabilityId":"spatial-exploration"},
      {"id":"capability-timed-progression","text":"Timed actions change which later interactions and routes are available.","fills":["engine_capability"],"capabilityId":"temporal-progression"},
      {"id":"capability-changing-topology","text":"Player actions create, remove or redirect connections between places.","fills":["engine_capability"],"capabilityId":"dynamic-topology"},
      {"id":"capability-object-interaction","text":"The player can carry, place or transfer a physical object as part of the objective.","fills":["engine_capability"],"capabilityId":"object-transport"},
      {"id":"capability-universal-domain","text":"A reusable engine domain is missing for the recorded interaction, space or progression need.","fills":["engine_capability"],"capabilityId":"generic-domain-extension"}
    ]
  },
  "requiredGapKinds": ["action_consequence","space_action","pressure_tradeoff","progression_escalation","replay_choice","feedback_state","concept_integration"],
  "gapLists": {
